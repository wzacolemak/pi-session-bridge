  "license": "MIT",
  "author": {
    "name": "wzacolemak"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wzacolemak/pi-session-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/wzacolemak/pi-session-bridge/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "pi-session-bridge",
    "session-bridge",
    "inter-agent",
    "cross-machine"
  ],
  "files": [
    "index.mjs",
    "cordis.patch.yml",
    "README.md"
  ],
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs"
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
